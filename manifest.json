{
  "manifest_version": 3,
  "name": "Yandex Mail Checker",
  "version": "1.3",
  "description": "Проверяет количество непрочитанных писем в Yandex почте",
  "minimum_chrome_version": "121",
  "permissions": [
    "storage",
    "alarms",
    "contextMenus",
    "notifications"
  ],
  "host_permissions": [
    "https://mail.yandex.ru/*"
  ],
  "action": {
    "default_title": "Яндекс.Почта"
  },
  "background": {
    "service_worker": "background.js",
    "scripts": [
      "background.js"
    ]
  },
  "icons": {
    "16": "icon16.png",
    "32": "icon32.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "yandex-mail-checker@ogurtsov-d.github.io",
      "strict_min_version": "128.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  }
}
