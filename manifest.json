{
  "manifest_version": 3,
  "name": "Yandex Mail Checker",
  "version": "1.4.0",
  "description": "Показывает количество непрочитанных писем Яндекс.Почты на иконке и уведомляет о новых письмах",
  "homepage_url": "https://github.com/Ogurtsov-D/Yandex_Mail_Checker",
  "minimum_chrome_version": "121",
  "permissions": ["storage", "alarms", "contextMenus", "notifications"],
  "host_permissions": ["https://mail.yandex.ru/*"],
  "action": {
    "default_title": "Яндекс.Почта",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "background": {
    "service_worker": "src/background.js",
    "scripts": ["src/background.js"],
    "type": "module"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "yandex-mail-checker@ogurtsov-d.github.io",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  }
}
