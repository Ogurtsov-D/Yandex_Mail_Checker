{
  "manifest_version": 3,
  "name": "Yandex Mail Checker",
  "version": "1.0",
  "description": "Проверяет количество непрочитанных писем в Yandex почте",
  "permissions": [
    "activeTab",
    "storage",
    "alarms",
    "contextMenus"
  ],
  "host_permissions": [
    "https://mail.yandex.ru/*"
  ],
  "action": {},
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icon16.png",
    "32": "icon32.png",
    "48": "icon48.png",
    "128": "icon128.png"
  }
}